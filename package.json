{
  "name": "scheme-calculator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "sync:bigquery": "tsx scripts/sync-bigquery.ts",
    "engine:run": "tsx scripts/engine-run.ts",
    "data:demo": "tsx scripts/load-demo-data.ts",
    "token:sign": "tsx scripts/sign-embed-token.ts",
    "auth:client": "tsx scripts/auth-client.ts",
    "auth:jwt-secret": "tsx scripts/auth-jwt-secret.ts",
    "admin:user": "tsx scripts/admin-user.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "qa:postman": "tsx qa/postman/build-collection.ts",
    "qa:swagger": "tsx qa/swagger/build-specs.ts",
    "qa:pick-dealers": "tsx qa/test-data/pick-dealers.ts",
    "qa:scans": "bash qa/security/run_scans.sh",
