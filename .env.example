# Description of every key. Ready files (git-ignored): .env (local), .env.dev, .env.uat, .env.prod.
# Run a script with another environment: npm run env -- <dev|uat|prod> <script>. Never commit them.

# PostgreSQL
DATABASE_URL=postgres://USER:PASSWORD@localhost:5433/scheme_calculator

# BigQuery (server side only). Use a service account key file, or Application Default Credentials when empty.
BIGQUERY_PROJECT_ID=example-project
BIGQUERY_DATASET=Testdb
BIGQUERY_LOCATION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=
# Or the service account key itself (no file to mount): base64 of the key file on one line
# (`base64 -w0 key.json`; macOS `base64 -i key.json`). Wins over GOOGLE_APPLICATION_CREDENTIALS. Secret.
BIGQUERY_CREDENTIALS_JSON=
# Stop a sync query that would scan more than this many bytes (cost guard).
# Routine sync (scheme period only, about 75 MB per query):
BIGQUERY_MAX_BYTES_BILLED=1000000000
# Base-period sync (Q1 FY 2026-27, reads the NULL partition, about 2.2 GB per query; runs once or with --base):
BIGQUERY_MAX_BYTES_BILLED_BASE=5000000000
# Daily BigQuery sync inside the app server: HH:MM (24-hour, India time) or off.
# Empty = 08:00, but off with APP_ENV=local. One instance runs it (database lock). It also runs once at server start
# when today's time has passed and today's sync has not succeeded yet. A failed sync is tried again after 30 minutes,
# at most 3 attempts for one day.
SYNC_DAILY_AT=
# Automatic database setup at server start: true (default when empty) or false.
# Applies new migrations in drizzle/ (a failure stops the server), seeds the schemes when src/config changed, and
# runs the engine after a seed or a new build. So a deployment needs no db:migrate, db:seed or engine:run.
DB_AUTO_SETUP=

# Iframe dealer identity: HMAC-SHA256 shared secret with SAP Commerce / SFA (min 32 chars)
EMBED_SIGNING_SECRET=
# Comma-separated origins that may frame the iframe, e.g. https://dms.example.com,https://sfa.example.com
EMBED_ALLOWED_ORIGINS=
# Development only: allow ?dealer_code=... without a token. Ignored when NODE_ENV=production.
ALLOW_DEV_DEALER_PARAM=false

# Admin report login
# Number of trusted reverse proxies in front of the app that append to X-Forwarded-For (0-10).
# 0 = do not trust X-Forwarded-For (the login limit and the API per-IP limits are then shared by all clients).
# Open item Q6 (DevOps): the other Acme API has nginx in front on Dev, so the likely value is 1 (nginx only).
# With 1 or more, the app port must accept connections only from the proxy (firewall or private network).
TRUSTED_PROXY_HOPS=0
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# More admin-area users, besides ADMIN_USERNAME (role ADMIN). JSON {"<username>": {"role": "ADMIN" | "CHOICES",
# "password": "<hash>"}}. Make a user with: npm run admin:user -- <username> [ADMIN|CHOICES]. Role CHOICES can open only
# Dealers and Reward choices (enter or upload the dealers' gift / CN choice). Empty = no other users.
ADMIN_USERS=

# Dealer status API (server-to-server, OAuth2 client credentials + JWT). See docs/api-contract.md section 3.
# APP_ENV: local | dev | uat | prod. Set local on a developer machine. NODE_ENV is not used.
# Dev: https://dev.scheme-calculator.example.com (decision Q8). UAT and production: same pattern, hosts to be confirmed.
# Startup rules: APP_ENV not set and no auth settings = the server does not start. Outside local, AUTH_CLIENTS and
# JWT_SECRET must be set and strong. The example client and key below are refused unless APP_ENV=local.
APP_ENV=
# JSON {"<client_id>":"<sha256 hex of client_secret>"}. Make a client with: npm run auth:client -- <client_id>
# Local example only: client_id local-client, client_secret local-test-secret.
AUTH_CLIENTS={"local-client":"0b1f90b824765bd860b58a3ebc0396a4f6f4c4ad8f1eed10135c0cb6cf3bd171"}
# Clients that may save reward choices (POST /api/v1/dealer-reward-choice, scope choices:write). Comma-separated
# client_ids; each must be in AUTH_CLIENTS. Empty = no client can write. Local example: local-client.
AUTH_WRITE_CLIENTS=local-client
# HS256 signing key, 32+ characters. Make one with: npm run auth:jwt-secret. Local example only:
JWT_SECRET=local-only-jwt-signing-key-not-for-servers-0001
# The old key while you rotate (tokens it signed stay valid until they expire). Empty = not used.
JWT_PREVIOUS_SECRET=
# Access token lifetime in seconds (60-86400).
JWT_TTL_SECONDS=3600
# Rate limits (Redis when REDIS_URL is set, else in memory for each process). false = all limits off.
RATE_LIMIT_ENABLED=true
# Requests per second for each client IP, on every /api path except the health probe.
RATE_LIMIT_PER_SECOND=2500
# Token requests per minute for each client IP (POST /api/v1/auth/token).
TOKEN_RATE_LIMIT_PER_MINUTE=30
# Dealer status requests per minute for each client_id (1-10000000). Default 100000 (1 lakh a minute, decision Q5).
API_RATE_LIMIT_PER_MINUTE=100000
# Redis for the rate limits and the response cache. Local container: scheme-calc-redis on port 6380.
# Forms: redis://[[user]:password@]host[:port][/db] (no TLS) or rediss://[[user]:password@]host[:port][/db] (TLS).
# Percent-encode special characters in the password (for example @ as %40). The app never logs the URL.
# Servers (Redis from the client's DevOps team, decision Q7): use rediss:// and a password when Redis is not on a
# private network, e.g. rediss://:<password>@<redis-host>:6380/0. TLS or not is still open (DevOps).
REDIS_URL=redis://localhost:6380/0
# Response cache of the dealer status API (needs REDIS_URL). The engine run makes old answers unused.
CACHE_ENABLED=false
CACHE_TTL_SECONDS=900
# Swagger UI at /api/docs and the spec at /api/v1/openapi.json. Empty = on only with APP_ENV=local.
# Decision Q9: set DOCS_ENABLED=true on Dev and UAT. Keep it empty (off) in production unless asked.
DOCS_ENABLED=
# Maximum database connections for each process (1-1000).
DATABASE_POOL_MAX=10
# Wait at most this long (ms, 100-60000) for a free database connection; then the API answers 503 SERVICE_BUSY.
DATABASE_POOL_TIMEOUT_MS=5000

# Local Postgres container (docker-compose.yml, local only)
POSTGRES_USER=scheme
POSTGRES_PASSWORD=
POSTGRES_DB=scheme_calculator

# Reverse proxy (nginx-proxy + Let's Encrypt on the server). The host name of this environment. Empty on a laptop.
# Dev: dev.scheme-calculator.example.com. UAT and production: same pattern, hosts to be confirmed.
VIRTUAL_HOST=
LETSENCRYPT_HOST=
